{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@iwsdk/vite-plugin-dev/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@sim/*": [
        "../src/sim/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../src/sim/*.ts"
  ],
  "exclude": [
    "../src/sim/*.test.ts"
  ]
}
