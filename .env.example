# Copier ce fichier en `.env` (ignoré par git) et renseigner la clé.
# `.env` n'est lu que par les scripts d'agents, via `node --env-file=.env`.
ANTHROPIC_API_KEY=sk-ant-...

# Identifiants créés par `ant apply` (voir claude-lock.json). Facultatif :
# si absents, le script les lit dans claude-lock.json.
# WEBXR_AGENT_ID=agent_...
# WEBXR_ENV_ID=env_...

# Plafond de dépense d'une session, en cents (100 = 1,00 $). Appliqué par la plateforme.
WEBXR_SESSION_BUDGET_CENTS=100
